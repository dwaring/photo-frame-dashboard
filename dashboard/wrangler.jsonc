{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "home-dashboard-photos"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
